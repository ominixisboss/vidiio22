<?xml version="1.0" encoding="utf-8"?>
<!--
  Default-deny cleartext. Every scraper response we parse decides what the player
  loads next, so an unencrypted one is a remote-control channel for anyone on the
  same network. HTTPS is required everywhere except the loopback exceptions below.

  If a source you need is HTTP-only, add its host to the domain-config below
  rather than re-enabling cleartext globally.
-->
<network-security-config>
    <!--
      The major public root CAs are bundled as a fallback to the system store, so older Fire TV
      sticks and Android TVs whose certificate store predates them do not fail with "Trust anchor
      for certification path not found": ISRG (Let's Encrypt), Google Trust Services, DigiCert,
      Amazon, USERTrust/Sectigo and GlobalSign roots, which between them sign nearly every site
      the app talks to. They are the roots' public certificates (binary DER files, so no text or line-ending quirks on old devices), taken from the Mozilla root
      program's bundle (ISRG Root X1 and GTS Root R4 also checked against the issuers' published
      SHA-256 values). They only add trust for those CAs; the system store is still consulted
      first and in full. A TV with a wrong clock fails the same way, and no certificate fixes that.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/amazon_root_1" />
            <certificates src="@raw/amazon_root_2" />
            <certificates src="@raw/amazon_root_3" />
            <certificates src="@raw/amazon_root_4" />
            <certificates src="@raw/digicert_global_g2" />
            <certificates src="@raw/digicert_global_g3" />
            <certificates src="@raw/digicert_tls_ecc_g5" />
            <certificates src="@raw/digicert_tls_rsa_g5" />
            <certificates src="@raw/globalsign_e46" />
            <certificates src="@raw/globalsign_r3" />
            <certificates src="@raw/globalsign_r46" />
            <certificates src="@raw/gts_root_r1" />
            <certificates src="@raw/gts_root_r3" />
            <certificates src="@raw/gts_root_r4" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
            <certificates src="@raw/sectigo_e46" />
            <certificates src="@raw/sectigo_r46" />
            <certificates src="@raw/starfield_services_g2" />
            <certificates src="@raw/usertrust_ecc" />
            <certificates src="@raw/usertrust_rsa" />

        </trust-anchors>
    </base-config>

    <!--
      The embedded TorrServer engine listens on loopback (see TorrServerEngine.baseUrl)
      and speaks plain HTTP. Traffic never leaves the device, so this is safe.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!--
      Debug builds additionally trust user-installed CAs so mitmproxy/Charles can be
      used to inspect scraper traffic. Never applies to release.
    -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/amazon_root_1" />
            <certificates src="@raw/amazon_root_2" />
            <certificates src="@raw/amazon_root_3" />
            <certificates src="@raw/amazon_root_4" />
            <certificates src="@raw/digicert_global_g2" />
            <certificates src="@raw/digicert_global_g3" />
            <certificates src="@raw/digicert_tls_ecc_g5" />
            <certificates src="@raw/digicert_tls_rsa_g5" />
            <certificates src="@raw/globalsign_e46" />
            <certificates src="@raw/globalsign_r3" />
            <certificates src="@raw/globalsign_r46" />
            <certificates src="@raw/gts_root_r1" />
            <certificates src="@raw/gts_root_r3" />
            <certificates src="@raw/gts_root_r4" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
            <certificates src="@raw/sectigo_e46" />
            <certificates src="@raw/sectigo_r46" />
            <certificates src="@raw/starfield_services_g2" />
            <certificates src="@raw/usertrust_ecc" />
            <certificates src="@raw/usertrust_rsa" />

        </trust-anchors>
    </debug-overrides>
</network-security-config>
