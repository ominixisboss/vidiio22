# Copy to app/keystore.properties and fill in. That file is gitignored.
# CI can skip this file entirely and set KEYSTORE_FILE / KEYSTORE_PASSWORD /
# KEY_ALIAS / KEY_PASSWORD as environment variables instead.
#
# If neither is present, `assembleRelease` still builds - just unsigned.
storeFile=/absolute/path/to/vidiio-release.jks
storePassword=
keyAlias=vidiio
keyPassword=
